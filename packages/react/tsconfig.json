{
  "compilerOptions": {
    "target": "ES2020",

    "module": "ESNext",
    "moduleResolution": "Node",

    "jsx": "react-jsx",

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "declaration": true,
    "outDir": "./dist",
    "rootDir": ".",

    "strict": true,
    "skipLibCheck": true
  },

  "include": [
    "./index.ts",
    "./react-apikit-error-ui-config.ts",
    "./ui_conponents/**/*.ts",
    "./ui_conponents/**/*.tsx"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}